# Local development (MongoDB exposed by Compose on localhost)
MONGODB_URI=mongodb://yacms:yacms-dev-password@localhost:27018/yacms?authSource=yacms
MONGODB_DB=yacms
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
MEDIA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Docker Compose database initialization
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-this-root-password
MONGO_APP_USERNAME=yacms
MONGO_APP_PASSWORD=yacms-dev-password
